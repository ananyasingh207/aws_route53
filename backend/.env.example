# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (supports comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:///./route53.db

# JWT Security Configuration (REQUIRED: Must be replaced with a secure random secret in production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Root User Initialization Configuration
ROOT_USER_NAME=Root User
ROOT_USER_EMAIL=replace-with-root-email
ROOT_USER_PASSWORD=replace-with-a-secure-password
